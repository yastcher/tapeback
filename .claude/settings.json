{
  "plansDirectory": "docs/spec",
  "showThinkingSummaries": true,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch(domain:*)",
      "Bash(find*)",
      "Bash(grep:*)",
      "Bash(head*)",
      "Bash(ls*)",
      "Bash(ps:*)",
      "Bash(tree:*)",
      "Bash(git * blame *)",
      "Bash(git check-ignore *)",
      "Bash(git * diff *)",
      "Bash(git * log *)",
      "Bash(git * ls-files *)",
      "Bash(git mv:*)",
      "Bash(git * show *)",
      "Bash(git *status*)",
      "Bash(uv add:*)",
      "Bash(uv build *)",
      "Bash(uv lock:*)",
      "Bash(uv run jupyter*)",
      "Bash(uv run python*)",
      "Bash(*uv run pytest*)",
      "Bash(*uv run ruff*)",
      "Bash(uv run ty*)",
      "Bash(uv sync*)",
      "Bash(uv venv:*)",
      "Bash(python*)",
      "Bash(/opt/tapeback/bin/python:*)",
      "Bash(*tapeback/.venv/bin/python*)",
      "Bash(nvcc *)",
      "Bash(nvidia-smi:*)",
      "Bash(pipewire *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Bash(rm -rf*)",
      "Bash(* rm *)",
      "Bash(sudo*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git restore*)"
    ]
  }
}
