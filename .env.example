TAPEBACK_VAULT_PATH=/home/user/obsidian-vault
# TAPEBACK_STT_BACKEND=local                # local (default) or openai (needs tapeback[stt])
# TAPEBACK_STT_MODEL=large-v3-turbo         # openai default: whisper-1
# TAPEBACK_STT_API_KEY=                     # remote STT only (TAPEBACK_STT_BACKEND=openai)
# TAPEBACK_STT_CONCURRENCY=4
# TAPEBACK_STT_TIMEOUT=900                  # remote upload read/write timeout (seconds); keep high for diarize
# TAPEBACK_STT_MAX_RETRIES=5                # app-level retries per chunk on timeouts/5xx
# TAPEBACK_STT_RETRY_BASE_DELAY=5
# TAPEBACK_STT_HEARTBEAT_SECONDS=15
# TAPEBACK_STT_FFMPEG_TIMEOUT=120
# Deprecated: use TAPEBACK_STT_MODEL instead
# TAPEBACK_WHISPER_MODEL=large-v3-turbo
# TAPEBACK_LANGUAGE=en                       # default: auto
# TAPEBACK_DEVICE=cuda
# TAPEBACK_COMPUTE_TYPE=auto
# TAPEBACK_BEAM_SIZE=4
# TAPEBACK_CHUNK_LENGTH=30
# TAPEBACK_PAUSE_THRESHOLD=1.0
# TAPEBACK_MONITOR_SOURCE=auto
# TAPEBACK_MIC_SOURCE=auto
# TAPEBACK_SESSIONS_DIR=/home/user/.local/state/tapeback/sessions
# TAPEBACK_TIMEZONE=UTC                      # default: the machine's own zone
# TAPEBACK_HF_TOKEN=hf_your_token_here
# TAPEBACK_DIARIZE=true
# TAPEBACK_MAX_SPEAKERS=
# TAPEBACK_CLUSTERING_THRESHOLD=
# TAPEBACK_SPECTRAL_MERGE_THRESHOLD=0.96
# TAPEBACK_SUMMARIZE=true
# TAPEBACK_LLM_PROVIDER=anthropic
# TAPEBACK_LLM_API_KEY=sk-ant-...
# TAPEBACK_LLM_MODEL=                       # empty: the provider's default (anthropic: claude-sonnet-5-5)
# TAPEBACK_LLM_MODEL=claude-haiku-5-5       # another anthropic model, by its API id
# TAPEBACK_LLM_MODEL=claude-opus-5-5
# The model applies to TAPEBACK_LLM_PROVIDER only; a fallback provider uses its own default.
#
# Other cloud providers. In this file the key goes in TAPEBACK_LLM_API_KEY; a provider's
# own variable (GROQ_API_KEY, ...) is read from the environment only, never from a file.
# TAPEBACK_LLM_PROVIDER=openai
# TAPEBACK_LLM_PROVIDER=groq
# TAPEBACK_LLM_PROVIDER=gemini
# TAPEBACK_LLM_PROVIDER=openrouter
# TAPEBACK_LLM_PROVIDER=deepseek
# TAPEBACK_LLM_PROVIDER=qwen

# A model on this machine: llama.cpp's llama-server, started for each summary.
# TAPEBACK_LLM_PROVIDER=local
# TAPEBACK_LLM_LOCAL_SERVER=llama-server
# TAPEBACK_LLM_LOCAL_MODEL=~/models/model.gguf   # empty: the pinned default, downloaded once
# TAPEBACK_LLM_LOCAL_CONTEXT=16384
# TAPEBACK_LLM_LOCAL_CLAMP_WAIT=600
# TAPEBACK_LLM_LOCAL_TIMEOUT=1800

# Any OpenAI-compatible API (its key goes in TAPEBACK_LLM_API_KEY):
# TAPEBACK_LLM_PROVIDER=openai_compatible
# TAPEBACK_LLM_BASE_URL=https://api.example.com/v1
# TAPEBACK_LLM_MODEL=model-name

# Seconds to wait for one answer from a cloud provider or an OpenAI-compatible API:
# TAPEBACK_LLM_TIMEOUT=600
