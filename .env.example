TAPEBACK_VAULT_PATH=/home/user/obsidian-vault
# TAPEBACK_STT_BACKEND=local                # local (default) or openai (needs tapeback[stt])
# TAPEBACK_STT_MODEL=large-v3-turbo         # openai default: whisper-1
# TAPEBACK_STT_API_KEY=                     # remote STT only (TAPEBACK_STT_BACKEND=openai)
# TAPEBACK_STT_CONCURRENCY=4
# TAPEBACK_STT_TIMEOUT=900                  # remote upload read/write timeout (seconds); keep high for diarize
# TAPEBACK_STT_MAX_RETRIES=5                # app-level retries per chunk on timeouts/5xx
# TAPEBACK_STT_RETRY_BASE_DELAY=5
# TAPEBACK_STT_HEARTBEAT_SECONDS=15
# TAPEBACK_STT_FFMPEG_TIMEOUT=120
# Deprecated: use TAPEBACK_STT_MODEL instead
# TAPEBACK_WHISPER_MODEL=large-v3-turbo
# TAPEBACK_LANGUAGE=en
# TAPEBACK_DEVICE=cuda
# TAPEBACK_COMPUTE_TYPE=auto
# TAPEBACK_BEAM_SIZE=5
# TAPEBACK_CHUNK_LENGTH=2
# TAPEBACK_PAUSE_THRESHOLD=1.0
# TAPEBACK_MONITOR_SOURCE=auto
# TAPEBACK_MIC_SOURCE=auto
# TAPEBACK_HF_TOKEN=hf_your_token_here
# TAPEBACK_DIARIZE=true
# TAPEBACK_MAX_SPEAKERS=
# TAPEBACK_CLUSTERING_THRESHOLD=
# TAPEBACK_SPECTRAL_MERGE_THRESHOLD=0.96
# TAPEBACK_SUMMARIZE=true
# TAPEBACK_LLM_PROVIDER=anthropic
# TAPEBACK_LLM_API_KEY=sk-ant-...
# TAPEBACK_LLM_MODEL=
#
# Free/cheap LLM providers (all OpenAI-compatible):
# TAPEBACK_LLM_PROVIDER=groq        # GROQ_API_KEY
# TAPEBACK_LLM_PROVIDER=gemini      # GEMINI_API_KEY
# TAPEBACK_LLM_PROVIDER=openrouter  # OPENROUTER_API_KEY
# TAPEBACK_LLM_PROVIDER=deepseek    # DEEPSEEK_API_KEY
# TAPEBACK_LLM_PROVIDER=qwen        # DASHSCOPE_API_KEY
